# supagloo-nodejs-api — local env for `npm run start` / `npm run dev`.
#
# Copy to `.env` (optional). In Docker Compose these are set by the `api` and
# `migrate` services; from the HOST use `localhost`, from inside the Compose
# network use host `postgres`.

# Prisma-managed application database (required — the env loader rejects a
# missing or non-postgres value).
DATABASE_URL=postgres://supagloo:supagloo@localhost:5432/supagloo

# Server bind (optional — these are the defaults).
PORT=4000
HOST=0.0.0.0

# --- Outbound provider base URLs (Task #9 convention) ---
# Default to the REAL provider URLs, so production needs zero config. GitHub needs two
# hosts: the REST API vs the user-authorization OAuth host. YOUVERSION_BASE_URL's
# default is a placeholder pending implementation-time verification.
#
# TASK 62: the test Compose overlay no longer overrides ANY of these. Task 34-E8
# removed the OpenRouter/Gloo/YouVersion overrides; task 62 removed the last two
# (GITHUB_API_BASE_URL / GITHUB_OAUTH_BASE_URL) when the github-stub was retired, so
# every e2e lane now reaches the real provider. Leave these UNSET unless you are
# deliberately pointing at a self-hosted host — an accidental value here silently
# diverts real e2e egress.
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_OAUTH_BASE_URL=https://github.com
OPENROUTER_BASE_URL=https://openrouter.ai
#
# PLAN ROW 66 — the user-authorization host splits PUBLIC vs INTERNAL.
# GITHUB_OAUTH_BASE_URL above is the PUBLIC half: the URL the USER'S BROWSER opens
# (the App install picker and the authorize redirect). It must resolve from the
# user's own machine, so it must NEVER be pointed at a Docker-network hostname —
# that is exactly the DNS_PROBE_FINISHED_NXDOMAIN failure plan row 62 item (e) was.
#
# GITHUB_OAUTH_INTERNAL_BASE_URL below is the SERVER half, used by `exchangeCode`
# and nothing else — a POST this process makes. Leave it UNSET everywhere except a
# test lane: unset it resolves to the public value, so production and every existing
# deployment need zero config (it is deliberately NOT modelled on the S3
# required-no-default pair — there IS a correct default here). `docker-compose.test.yml`
# sets it to http://api:4000 so the containerised api completes that one hop against
# ITSELF, where its double-gated test-only route answers (see
# GITHUB_E2E_EXCHANGE_TOKEN below).
GITHUB_OAUTH_INTERNAL_BASE_URL=
GLOO_BASE_URL=https://platform.ai.gloo.com
YOUVERSION_BASE_URL=https://api.youversion.com

# --- GitHub App (Task #11, design-delta §2.3) ---
# Required. App-level secrets/config for the GitHub App (one pair per app
# registration, shared by the API and DBOS — NOT per-user, so outside the §2.10
# encryption scheme). The API signs ~10-min App JWTs to verify installations and
# mint short-lived installation tokens, and builds the hosted install URL
# ({GITHUB_OAUTH_BASE_URL}/apps/{GITHUB_APP_SLUG}/installations/new). The private
# key is the app's PKCS#1/PKCS#8 PEM; a single-line value with escaped \n is
# accepted (normalized before signing).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=

# Task #26 create-new-repo JIT hop (design-delta §2.3/§6b). Required — the
# create-new-repo flow cannot proceed without them. This is the App's OAuth-style
# user-to-server client id/secret (distinct from the App JWT above): it exchanges
# a short-lived user authorization code for a per-request user access token, used
# once to create the repo under the user's account, then discarded (never stored).
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# --- Application secrets key (Task #12, design-delta §2.10) ---
# Required. The single AES-256-GCM key used to encrypt/decrypt per-user provider
# secrets at rest (the OpenRouter API key, the Gloo client secret). A 64-char hex
# string (32 bytes), distinct per environment. Generate one with:
#   openssl rand -hex 32
# NOT per-user data — one key per deployment, shared by the API and DBOS.
SECRETS_ENCRYPTION_KEY=

# --- S3 object storage (Task #13, design-delta §4) ---
# Required (except S3_REGION, which defaults to us-east-1). The API presigns
# DOWNLOAD URLs only. TWO endpoints: S3_ENDPOINT is the internal Docker-network
# address for server-to-server ops; S3_PUBLIC_ENDPOINT is the browser-reachable
# address that presigned URLs are SIGNED against (a URL signed against minio:9000 is
# unreachable from a browser). From the HOST both resolve via localhost; inside the
# Compose network the internal one is http://minio:9000. Dev values below point at
# the Compose MinIO; prod uses the Railway bucket.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=supagloo-dev
S3_ACCESS_KEY=supagloo
S3_SECRET_KEY=supagloo-dev
S3_REGION=us-east-1

# --- Test-only seed gate (Task #10, §9-Q9) ---
# Optional. Gates the deterministic POST /v1/test/seed endpoint, which is only
# registered when NODE_ENV !== 'production' AND this equals '1'. Leave unset in a
# real .env (and always in prod — the endpoint must not exist there). The e2e
# harness (docker-compose.test.yml) sets it to '1'; developers normally don't.
SUPAGLOO_ENABLE_TEST_SEED=


# --- E2E provider secrets (design-delta §10.8, task 34-E2) ---
# The real-provider gating e2e suite hits the LIVE OpenRouter / Gloo / YouVersion
# APIs. The vars below are REQUIRED: a missing one must FAIL the e2e global-setup fast
# with an actionable message (34-E8) — a suite that silently skips provider tests is a
# green lie. Only YOUVERSION_E2E_ACCESS_TOKEN is deliberately optional. These are
# e2e-SETUP secrets, NOT app-boot config (src/config/env.ts / task 43) — Gloo/OpenRouter
# creds are per-user encrypted DB rows in production. CI wiring is out of scope (§9-Q12).

# YouVersion Platform API key — NOT currently wired into api's src/ (zero
# references; not even declared in src/config/env.ts). The X-YVP-App-Key auth
# header convention remains unverified (§9-Q10); api's userinfo path today
# forwards the caller's own bearer token instead. Listed here as a required
# e2e-setup secret pending that resolution.
YOUVERSION_APP_KEY=

# Real, live-verifiable Gloo AI client credentials. api-e2e drives the real connect
# routes with these (PUT /v1/connections/gloo verify-then-store mints a live token).
GLOO_CLIENT_ID=
GLOO_CLIENT_SECRET=

# A DEDICATED, LOW-BALANCE OpenRouter key (design-delta §10.3/§10.9) — the low cap is
# the backstop against a runaway suite. Never reuse a production key here.
OPENROUTER_E2E_TEST_API_KEY=

# Optional (the ONE deliberately-optional real spec, design-delta §10.4b): a dedicated
# test account's YouVersion access token for the live userinfo round-trip (34-E6).
# When unset, that spec skips LOUDLY (never silently). The vars above do NOT skip.
YOUVERSION_E2E_ACCESS_TOKEN=


# --- E2E real-GitHub secrets (task 62, design-delta §11.8) ---
# Since task 62 there is NO github-stub and NO local git server: every GitHub-touching
# e2e (github-connection, manifest, repo-provisioning) reaches real github.com /
# api.github.com. Those specs read their credentials from the ROOT repo's untracked
# `.env` (loaded per vitest worker by tests/e2e/load-root-env.ts), so in practice you
# populate them THERE, not here — this file documents the names.
#
# The four REQUIRED vars are: GITHUB_APP_ID, GITHUB_APP_SLUG, GITHUB_APP_PRIVATE_KEY
# (all three already documented above) and GITHUB_E2E_PAT_TOKEN below. A missing one
# makes the GitHub e2e specs THROW with the var name + this file — never skip. A suite
# that silently skipped its GitHub coverage is a green lie (design-delta §10.8, plan
# row 56 item 2).
#
# The installation id is NOT a variable: it is DISCOVERED at runtime via
# `GET /app/installations`. Installation ids change on reinstall, so hardcoding one
# guarantees a future red run. If the App has zero installations the harness fails
# fast naming https://github.com/apps/<GITHUB_APP_SLUG>/installations/new.

# A classic Personal Access Token with the `repo` scope, used ONLY to create the
# throwaway fixture repositories the e2e needs. It is REQUIRED and cannot be replaced
# by an installation token: the GitHub App installation grants
# contents:write + pull_requests:write + metadata:read and NO `administration`, so an
# installation token structurally cannot create (or archive) a repository. Everything
# the product itself does is still exercised with an installation token minted by
# unchanged product code.
#
# HOST-SIDE ONLY. This value must never be added to a Compose service's environment,
# never reach a render child process, and never appear in a log or a checkpoint. It is
# a strictly STRONGER credential than production ever holds. For the narrower credential
# that DOES enter this service's container, see GITHUB_E2E_EXCHANGE_TOKEN below.
GITHUB_E2E_PAT_TOKEN=

# A SECOND, DELIBERATELY NARROWER GitHub credential, read by THIS service (plan row 66).
# Unlike every other var in this block it is not merely harness-side: it is consumed by
# the test-only token-exchange route this repo registers, and it is therefore the ONE
# GitHub credential that enters the api container.
#
# The route is double-gated exactly like POST /v1/test/seed — NODE_ENV !== 'production'
# AND SUPAGLOO_ENABLE_TEST_SEED === '1' (the literal string, not truthiness). Failing
# either gate, the route is never REGISTERED, so it hard-404s. It exists so the nextjs
# browser lane can drive the create-new-repo round trip against real GitHub: the second
# hop, POST /login/oauth/access_token, is a server-side call the browser cannot shim,
# and GITHUB_OAUTH_BASE_URL cannot be pointed at an internal host because it is
# simultaneously the browser's authorize-redirect target (hence the public/internal
# split above).
#
# Scopes: repository CREATION only — a FINE-GRAINED token with `Administration: Read and
# write` on your own account and NOTHING else. Deliberately NOT `delete_repo`.
# Mint at: https://github.com/settings/personal-access-tokens/new
#
# As with the rest of this block, populate it in the ROOT repo's untracked `.env`; the
# container receives it via ${GITHUB_E2E_EXCHANGE_TOKEN} substitution. Never inline the
# literal in a tracked file. Absent value ⇒ the route fails fast naming this variable,
# never a placeholder and never a silent skip.
GITHUB_E2E_EXCHANGE_TOKEN=

# Optional. Which account's App installation to use when the App is installed in more
# than one account. When exactly ONE installation exists it is adopted automatically,
# so this normally stays unset; with several installations and no value here the
# harness throws and lists the logins it found.
SUPAGLOO_E2E_GITHUB_OWNER=

# Optional. Where the ROOT Supagloo repo is checked out. The e2e harness resolves it as
# a sibling of this repo by default, and imports the SHARED real-GitHub harness from
# <root>/tests/support/e2e-github-naming.mjs + e2e-github-api.mjs. Set this only if the
# root repo lives somewhere else.
SUPAGLOO_ROOT_DIR=

# FIXTURE REPOS ARE NEVER AUTO-REMOVED. Each run creates private throwaway repos named
# `supagloo-e2e-delete-me-<slug>-<runid>` in the installation's account, and NOTHING in
# the test suite deletes or archives them (you almost always need them to debug a red
# run, and automatic mutation in an account that also holds real repositories is
# unacceptable). Reclaim them from the ROOT repo with:
#     npm run cleanup:github-e2e
# which ARCHIVES (never deletes), asks per repo, and refuses any name failing the
# `supagloo-e2e-delete-me-` prefix gate even if you answer yes.
